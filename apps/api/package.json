{
  "name": "@applypilot/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run db:generate:postgres",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run db:generate && cross-env NODE_ENV=test DATABASE_URL=file:./prisma/test.db prisma db push --schema prisma/schema.prisma && cross-env NODE_ENV=test DATABASE_URL=file:./prisma/test.db vitest run",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:postgres": "cross-env PRISMA_SCHEMA=prisma/schema.postgresql.prisma prisma migrate dev",
    "db:deploy": "cross-env PRISMA_SCHEMA=prisma/schema.postgresql.prisma prisma migrate deploy",
    "db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
