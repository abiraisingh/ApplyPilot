generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  applications     Application[]
  emailIntegration EmailIntegration?
  emailOAuthStates EmailOAuthState[]
  resumes          ResumeDocument[]
  interviewPreps   InterviewPrep[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailIntegration {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  email                 String
  encryptedRefreshToken String
  lastSyncedAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedMessages      ImportedEmailMessage[]
}

model EmailOAuthState {
  id        String   @id @default(uuid())
  stateHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ImportedEmailMessage {
  id            String           @id @default(uuid())
  integrationId String
  messageId     String
  outcome       String
  createdAt     DateTime         @default(now())
  integration   EmailIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, messageId])
  @@index([integrationId, createdAt])
}

model Application {
  id             String             @id @default(uuid())
  userId         String
  companyName    String
  role           String
  jobUrl         String?
  jobDescription String?
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  appliedAt      DateTime?
  status         ApplicationStatus  @default(SAVED)
  notes          String?
  priority       Int                @default(0)
  nextAction     String?
  followUpAt     DateTime?
  source         String             @default("MANUAL")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ApplicationEvent[]
  interviewPreps InterviewPrep[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

model ApplicationEvent {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ResumeDocument {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String   @default("")
  contentType String
  size        Int
  content     Bytes
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InterviewPrep {
  id            String       @id @default(uuid())
  userId        String
  applicationId String?
  title         String
  scheduledAt   DateTime?
  notes         String       @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([applicationId])
}
