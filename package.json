{
  "name": "applypilot",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @applypilot/api",
    "dev:web": "npm run dev --workspace @applypilot/web",
    "build": "npm run build --workspace @applypilot/api && npm run build --workspace @applypilot/web",
    "typecheck": "npm run typecheck --workspace @applypilot/api && npm run typecheck --workspace @applypilot/web",
    "test": "npm run test --workspace @applypilot/api",
    "db:generate": "npm run db:generate --workspace @applypilot/api",
    "db:migrate": "npm run db:migrate --workspace @applypilot/api",
    "db:deploy": "npm run db:deploy --workspace @applypilot/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3"
  }
}
